{
    "family": "nerf-backend",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::your-account-id:role/ECSExecutionRole",
    "taskRoleArn": "arn:aws:iam::your-account-id:role/ECSTaskRole",
    "containerDefinitions": [
      {
        "name": "nerf-backend",
        "image": "827432256119.dkr.ecr.us-east-1.amazonaws.com/nerf-backend:latest",
        "memory": 4096,
        "cpu": 1024,
        "essential": true,
        "portMappings": [
          {
            "containerPort": 8000,
            "hostPort": 8000
          }
        ],
        "environment": [
          { "name": "S3_BUCKET_NAME", "value": "nerf-pipeline-bucket" },
          { "name": "RDS_HOST", "value": "nerf-rds.cv886guc6d40.us-east-1.rds.amazonaws.com" },
          { "name": "RDS_PORT", "value": "5432" },
          { "name": "RDS_DB_NAME", "value": "nerf-rds" },
          { "name": "RDS_USER", "value": "postgres" },
          { "name": "RDS_PASSWORD", "value": "earthmera_rds" }
        ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/nerf-backend",
            "awslogs-region": "us-east-1",
            "awslogs-stream-prefix": "ecs"
          }
        }
      }
    ],
    "requiresCompatibilities": ["EC2"],
    "cpu": "1024",
    "memory": "4096"
  }
  